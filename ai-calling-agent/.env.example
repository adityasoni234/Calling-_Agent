# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME="AI Calling Agent"
# local | test | staging | production
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
# true in production, for log aggregation
LOG_JSON=false

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12
# set false once your team's accounts exist
ALLOW_REGISTRATION=true

# --- database --------------------------------------------------------------
# POSTGRES_PORT is the HOST port only. Containers always talk to each other on
# 5432 internally. 5433 avoids clashing with a Postgres installed on the Mac.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=calling_agent
POSTGRES_PORT=5433
# Inside Docker Compose the host is the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/calling_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- http ------------------------------------------------------------------
# Local dev plus the deployed Firebase origins. No trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- frontend (Vite: only VITE_* reaches the browser; never put secrets here)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ===========================================================================
# PROVIDERS
#
# Every provider defaults to "mock". The whole pipeline - calls, barge-in,
# RAG, campaigns, summaries, costing - runs end to end with no vendor account
# and no bill. Swap a provider to a real one only when you have its key.
# ===========================================================================

# --- which provider to use for each capability -----------------------------
# telephony: mock | plivo | twilio | telnyx
TELEPHONY_PROVIDER=mock
# stt: mock | deepgram
STT_PROVIDER=mock
# llm: mock | anthropic | openai
LLM_PROVIDER=mock
# tts: mock | cartesia | deepgram | elevenlabs
TTS_PROVIDER=mock
# embeddings: mock | openai
EMBEDDING_PROVIDER=mock

# --- telephony -------------------------------------------------------------
# The https URL the carrier calls back on. Must be publicly reachable, so in
# development use a tunnel: `cloudflared tunnel --url http://localhost:8000`
# or `ngrok http 8000`, then paste the https URL here.
PUBLIC_BASE_URL=http://localhost:8000
# Optional shared secret appended to webhook URLs and checked on arrival.
TELEPHONY_WEBHOOK_SECRET=

# Plivo (console.plivo.com -> Account -> Keys)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# A number you own, in E.164, verified for outbound calling
PLIVO_CALLER_ID=

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# Telnyx (portal.telnyx.com)
# API key: Account -> API Keys. Connection ID: the Call Control application
# your number is assigned to (Voice -> Call Control Applications).
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_CALLER_ID=

# --- speech to text --------------------------------------------------------
# Deepgram (console.deepgram.com). Also used for Deepgram Aura TTS.
DEEPGRAM_API_KEY=
STT_MODEL=nova-2
# "multi" enables code-switching, which is what Hinglish calls need
STT_LANGUAGE=multi

# --- language model --------------------------------------------------------
# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Only needed for identity-linked keys, which must name a workspace.
# Find it with: GET https://api.anthropic.com/v1/organizations/workspaces
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=300
# OpenAI, or any OpenAI-compatible endpoint (Groq, Together, vLLM...)
OPENAI_API_KEY=
# Set only for a non-OpenAI compatible endpoint, e.g. http://vllm:8000/v1
LLM_BASE_URL=

# --- text to speech --------------------------------------------------------
# Cartesia (play.cartesia.ai)
CARTESIA_API_KEY=
# ElevenLabs (elevenlabs.io) - higher quality, higher cost
ELEVENLABS_API_KEY=
# Default voice when an agent has none set
TTS_VOICE_ID=
TTS_MODEL=

# --- embeddings (RAG) ------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
# Changing this requires a new migration: it is the vector column width.
EMBEDDING_DIM=1536

# --- conversation tuning ---------------------------------------------------
BARGE_IN_ENABLED=true
# Turns older than this are compressed into a local digest instead of resent,
# which is what keeps token cost linear in call length.
CONTEXT_MAX_TURNS=12
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# --- safety limits ---------------------------------------------------------
# Hard ceiling across all campaigns. Uncontrolled parallel dialing is a cost
# incident and a compliance incident.
MAX_GLOBAL_CONCURRENT_CALLS=10
# 0 means no cap. Checked before a call is placed, never after.
DAILY_BUDGET_USD=0
MONTHLY_BUDGET_USD=0
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
TWILIO_WHATSAPP_NUMBER=
