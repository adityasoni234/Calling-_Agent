# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME="AI Calling Agent"
# local | test | staging | production
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
# true in production, for log aggregation
LOG_JSON=false

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12
# set false once your team's accounts exist
ALLOW_REGISTRATION=true

# --- database --------------------------------------------------------------
# POSTGRES_PORT is the HOST port only. Containers always talk to each other on
# 5432 internally. 5433 avoids clashing with a Postgres installed on the Mac.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=calling_agent
POSTGRES_PORT=5433
# Inside Docker Compose the host is the service name `postgres`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/calling_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- http ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- frontend (Vite: only VITE_* reaches the browser; never put secrets here)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ===========================================================================
# Phases 2-9. Left blank on purpose -- no provider key is required to run
# Phase 1, and no rate is hard-coded anywhere in the application.
# ===========================================================================

# --- provider selection ----------------------------------------------------
# TELEPHONY_PROVIDER=plivo        # plivo | twilio
# STT_PROVIDER=deepgram           # deepgram | whisper_local | sarvam
# LLM_PROVIDER=anthropic          # anthropic | openai | gemini | vllm
# TTS_PROVIDER=cartesia           # cartesia | deepgram | elevenlabs | sarvam | piper

# --- telephony credentials -------------------------------------------------
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_CALLER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_CALLER_ID=
# PUBLIC_BASE_URL=                # https URL the telephony provider calls back on

# --- model providers -------------------------------------------------------
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
