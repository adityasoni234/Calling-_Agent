# Copied to .env.production before `npm run deploy`.
# Only VITE_* variables reach the browser and they are baked into the bundle at
# build time — never put a provider key here. The backend holds all of those.
#
# Must be your deployed backend, ending in /api/v1.
VITE_API_BASE_URL=https://calling-agent-api.onrender.com/api/v1
